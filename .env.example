# ── Database ──────────────────────────────────────────────
# MySQL connection string (PlanetScale, Railway, or any MySQL 8 host)
DATABASE_URL=mysql://user:password@host:3306/luxe_db

# ── Auth / Session ────────────────────────────────────────
# Any long random string (openssl rand -base64 32)
JWT_SECRET=replace-with-a-long-random-secret

# ── Stripe ───────────────────────────────────────────────
# Live keys from dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── App ID (optional) ────────────────────────────────────
VITE_APP_ID=

# ── OAuth (optional — only if using Manus OAuth) ─────────
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# ── Manus Notification (optional — Manus-hosted only) ────
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
