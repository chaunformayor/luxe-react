{
  "version": 2,
  "buildCommand": "vite build && esbuild api/index.ts --bundle --platform=node --packages=external --format=esm --outfile=api/index.js",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist/public",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
